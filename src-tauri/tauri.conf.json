{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super Agent Party",
  "version": "0.1.0",
  "identifier": "com.superagent.party",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icons": []
  }
}
